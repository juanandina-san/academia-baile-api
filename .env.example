PORT=3000

# --- Base de datos ---
# En Vercel, la integración TiDB Cloud del Marketplace inyecta
# TIDB_HOST / TIDB_PORT / TIDB_USER / TIDB_PASSWORD / TIDB_DATABASE (o DATABASE_URL).
# No hace falta copiarlas a DB_*: src/config/db.js las detecta solo y activa TLS.
# Para desarrollo local u otro MySQL, completar DB_*:

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu contraseña de MySQL
DB_NAME=academia_baile

# TLS: por defecto se activa automáticamente si se detecta TiDB.
# Forzalo con true/false si tu host lo requiere o lo prohíbe.
DB_SSL=false
# Contenido del certificado CA; vacío = usar CA del sistema.
DB_SSL_CA=
# Conexiones por instancia: 2 por defecto en Vercel, 10 en local.
DB_POOL_LIMIT=10

JWT_SECRET=cualquier texto largo
ANTHROPIC_API_KEY=tu clave de IA
IA_MODEL=claude-sonnet-5-5
# Orígenes permitidos por CORS, separados por comas. Vacío = todos (solo local).
CORS_ORIGIN=https://tu-web.vercel.app,https://tu-web.netlify.app
# Secreto para GET/POST /api/jobs/estados (Vercel Cron usa Bearer).
CRON_SECRET=cualquier texto largo y aleatorio
